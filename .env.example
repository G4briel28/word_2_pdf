# Copie este archivo a .env (nunca versione .env) o ejecute scripts/generate-env.ps1 / scripts/generate-env.sh,
# que genera secretos aleatorios automáticamente.

# Secreto JWT compartido entre word2pdf y ONLYOFFICE (mínimo 32 bytes).
#   Linux/macOS: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=

# API keys aceptadas por word2pdf (separadas por comas, mínimo 24 caracteres cada una).
APP_API_KEYS=
APP_API_KEY_ENABLED=true

# Publicación del servicio Java (127.0.0.1 = solo esta máquina).
APP_BIND=127.0.0.1
APP_PORT=8080

# Límites
APP_MAX_CONCURRENT=4
APP_MAX_INPUT_SIZE=20MB
APP_QUEUE_TIMEOUT=30s
ONLYOFFICE_CONVERSION_TIMEOUT=120s

# Fidelidad: true = rechazar (422) en lugar de solo avisar
APP_FIDELITY_FAIL_ON_FONTS=false
APP_FIDELITY_FAIL_ON_PAGE_SIZE=false

# Fuentes adicionales montadas en ONLYOFFICE
FONTS_DIR=./fonts

# Recursos
ONLYOFFICE_CPUS=2
ONLYOFFICE_MEMORY=4g
APP_CPUS=1.5
APP_MEMORY=1g
ONLYOFFICE_LOG_LEVEL=WARN
